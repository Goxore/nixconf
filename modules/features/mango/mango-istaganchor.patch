+Client *client_find_tag_anchor(Client *w) {
+	Client *c = NULL;
+
+	if (!w->pid)
+		return NULL;
+
+	wl_list_for_each(c, &server.focus_stack, flink) {
+		if (c->istaganchor && c->mon && c->tags && c->pid &&
+			c->pid != w->pid && is_descendant_process(c->pid, w->pid)) {
+			return c;
+		}
+	}
+
+	return NULL;
+}
